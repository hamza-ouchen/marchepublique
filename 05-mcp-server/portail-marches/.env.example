# Configuration du portail — aucune valeur sensible ici
PORTAIL_MODE=demo            # demo (fixtures, zéro réseau) | portail (réel)
PORTAIL_BASE_URL=https://www.marchespublics.gov.ma
DELAI_ENTRE_APPELS_S=2       # débit limité — politesse obligatoire
CONTACT_BOT=contact@sou9na.ma

# HTTP (plateforme agentique — StreamableHTTP, POST /mcp)
MCP_TRANSPORT=streamable-http
FASTMCP_HOST=0.0.0.0
FASTMCP_PORT=8202
# Bearer token (SSE/HTTP) — si défini, les requêtes sans Bearer reçoivent 401.
# Même valeur que MCP_AUTH_TOKEN côté client / plateforme.
MCP_AUTH_TOKEN=
