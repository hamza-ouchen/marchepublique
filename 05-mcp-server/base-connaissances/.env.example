# Configuration du moteur de recherche — rien de sensible ici.
# Les vraies valeurs vont dans .env (gitignoré), jamais dans ce fichier.
MOTEUR=auto                  # rag (package RAG) | auto (historique) | lexical (JSON seulement)
# Livraison RAG : installer 06-connaissances/astra-rag puis choisir MOTEUR=rag.
# Le mode rag ne replie jamais reglementation vers faq ou vers un corpus non filtré.
CORPUS_DIR=corpus

# Astra DB — Data API (collection unique `sou9na`)
ASTRA_DB_API_ENDPOINT=
ASTRA_DB_API_TOKEN=
ASTRA_DB_COLLECTION=sou9na
ASTRA_DB_KEYSPACE=default_keyspace
# Lecture des CPS prêts et journalisation par le worker RAG (côté serveur uniquement).
DATABASE_URL=

# HTTP (plateforme agentique — StreamableHTTP, POST /mcp)
MCP_TRANSPORT=streamable-http
FASTMCP_HOST=0.0.0.0
FASTMCP_PORT=8203
# Bearer token (SSE/HTTP) — si défini, les requêtes sans Bearer reçoivent 401.
# Même valeur que MCP_AUTH_TOKEN côté client / plateforme.
MCP_AUTH_TOKEN=
