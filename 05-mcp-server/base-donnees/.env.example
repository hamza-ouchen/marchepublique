# Connexion Supabase (pooler, mode transaction) — JAMAIS de valeur réelle ici
# Format : postgresql://postgres.<REF_PROJET>:<MOT_DE_PASSE>@<hote-pooler>:6543/postgres
DATABASE_URL=postgresql://postgres.__REF_PROJET__:__MOT_DE_PASSE__@__HOTE_POOLER__:6543/postgres

# HTTP (plateforme agentique — StreamableHTTP, POST /mcp)
MCP_TRANSPORT=streamable-http
FASTMCP_HOST=0.0.0.0
FASTMCP_PORT=8201
# Bearer token (SSE/HTTP) — si défini, les requêtes sans Bearer reçoivent 401.
# Même valeur que MCP_AUTH_TOKEN côté client / plateforme.
MCP_AUTH_TOKEN=
