# Serveur MCP "canaux" — variables d'environnement
# Copier ce fichier en ".env" et remplir avec les vraies valeurs.
# NE JAMAIS committer le fichier ".env" réel (il contient des secrets).

# --- WhatsApp Business Cloud API (Meta) ---
WHATSAPP_TOKEN=               # Token permanent du System User (app "Sou9na")
WHATSAPP_PHONE_NUMBER_ID=     # ID du numéro WhatsApp Business (test ou prod)
WHATSAPP_API_VERSION=v21.0    # Version de l'API Graph utilisée

# --- Gmail SMTP (email) — solution de test avant soutenance ---
# Pas besoin de domaine personnalisé : on envoie directement via les serveurs Gmail.
GMAIL_ADDRESS=                 # Adresse Gmail utilisée pour l'envoi (ex: xxx@gmail.com)
GMAIL_APP_PASSWORD=            # Mot de passe d'application Gmail (PAS le mot de passe normal)
                               # À générer sur https://myaccount.google.com/apppasswords
                               # (nécessite la validation en 2 étapes activée sur le compte)
GMAIL_SENDER_NAME=Sou9na

# --- Brevo (email) — ARCHIVÉ, à réactiver après la soutenance ---
# Nécessite un domaine personnalisé authentifié (SPF/DKIM/DMARC) pour fonctionner correctement.
# BREVO_API_KEY=                # Clé API du compte Brevo
# BREVO_SENDER_EMAIL=           # Adresse expéditeur vérifiée sur Brevo (domaine pro, pas @gmail.com)
# BREVO_SENDER_NAME=Sou9na

# --- Sécurité / limites (securite.py) ---
RATE_LIMIT_PAR_DESTINATAIRE_24H=1   # ex: 1 digest par destinataire par 24h
RATE_LIMIT_PAR_CONVERSATION_5MIN=1  # ex: 1 message par conversation par 5min
RATE_LIMIT_BURST_MAX=10             # ex: seuil avant rejet (burst protection)

# --- Journalisation (journal.py) ---
JOURNAL_NIVEAU=INFO           # DEBUG | INFO | WARNING | ERROR
