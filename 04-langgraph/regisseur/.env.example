# ═══════════════════════════════════════════════════════════════════
# RÉGISSEUR — registre des endpoints
# Aucune valeur ici — vous remplirez vous-même les propriétés dans
# votre .env (jamais commité). Format attendu pour chaque paire :
#   <PAIRE>_URL    = https://…   (URL exacte vue par vos appelants)
#   <PAIRE>_TOKEN  = jeton…      (borne au propriétaire de l'URL)
# Modèle identique projet Coach (Evolve AI).
# ═══════════════════════════════════════════════════════════════════

# ── 1. Base de données ──────────────────────────────────────────────
DATABASE_URL=

# ── 2. Mode de l'agent : demo | reel ────────────────────────────────
MODE_AGENTS=

# ── 3. Identité de CET agent (appel externe, ex. FastAPI) ──────────
REGISSEUR_URL=
REGISSEUR_TOKEN=

# ── 4. Agents (A2A — JSON-RPC 2.0, méthode message/send) ───────────
INSPECTEUR_URL=
INSPECTEUR_TOKEN=
COMPAGNON_URL=
COMPAGNON_TOKEN=
JUGE_URL=
JUGE_TOKEN=
CONCIERGE_URL=
CONCIERGE_TOKEN=
SENTINELLE_URL=
SENTINELLE_TOKEN=
# (jeton partagé de secours si un <*>_TOKEN est absent)
A2A_TOKEN=
A2A_TIMEOUT_S=

# ── 5. Serveurs MCP utilisés par LangGraph (toujours en local)
# La plateforme Agentic utilise ses propres URL ngrok, pas ce fichier.
MCP_BASE_DONNEES_URL=http://127.0.0.1:8201/mcp
MCP_PORTAIL_MARCHES_URL=http://127.0.0.1:8202/mcp
MCP_BASE_CONNAISSANCES_URL=http://127.0.0.1:8203/mcp
MCP_AUTH_TOKEN=

# ── 6. Serveur MCP stdio local (usage interne RÉGISSEUR) ────────────
MCP_BASE_DONNEES=

# ── 7. HTTP de ce serveur (serveur_http.py — défaut 8100) ──────────
PORT=
