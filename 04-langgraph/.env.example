# SOU9NA — Agents (LangGraph / LangFlow)
MISTRAL_API_KEY=
ANTHROPIC_API_KEY=
DATABASE_URL=
ASTRA_DB_APPLICATION_TOKEN=
LANGSMITH_API_KEY=
LANGCHAIN_PROJECT=

# ── Collecte de documents (inspecteur) ──────────────────────────────
# DATABASE_URL est déjà définie ci-dessus (même base Supabase).
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
# Limites free tier Storage (valeurs par défaut)
CPS_MAX_PDF_BYTES=5242880
CPS_MAX_PAGES=60
CPS_MAX_DOCS=30
CPS_TOTAL_BUDGET_BYTES=104857600
# false = texte+sections en DB uniquement (original non uploadé)
CPS_STORE_ORIGINALS=false
CPS_BUCKET=cps-originaux
PORTAL_DELAY_S=1.0
PORTAL_TIMEOUT_S=10
# Sources HTTP exploitables (JS-protégées exclues)
CPS_ALLOWED_HOSTS=www.marchespublics.gov.ma
# OCR (PDF scannés) : binaire + données 'fra' (fichier non commité)
# TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe
# TESSDATA_DIR=04-langgraph/inspecteur/tessdata
OCR_LANG=fra
OCR_DPI=200
# Surcharges optionnelles de la cible (sinon déduite des profils actifs)
# CPS_SECTORS=travaux,informatique
# CPS_REGIONS=casa-settat,tanger-tetouan-alhoceima
# CPS_MAX_CAPACITY_MAD=3000000

# ── Job complet (full-job : offres, statuts, documents, champs) ────
WALK_MINUTES=10
AUDIT_MINUTES=4
AUDIT_WORKERS=6
DOCS_MINUTES=8
FIELDS_MINUTES=5
CPS_MAX_DOCS_PER_TENDER=12
CPS_MAX_ZIP_BYTES=83886080
AO_FALLBACK_ENABLED=true
AO_BASE=https://www.aomaroc.com
# Identité déclarée au portail pour le téléchargement DCE
DCE_NOM=Soukna
DCE_PRENOM=Bot
DCE_EMAIL=contact@soukna.ma
DCE_RAISON_SOCIAL=Soukna
DCE_ICE=0023456780000AB
DCE_ADRESSE=Casablanca
DCE_VILLE=Casablanca
DCE_CP=20000
DCE_TEL=0600000000
# true = offres terminées supprimées de 'tenders' (défaut) ; false = marquées
DELETE_FINISHED_OFFERS=true
