# Laisser vide pour utiliser le proxy Next /api/* -> FastAPI (recommandé en prod).
# En développement local, viser directement le backend :
# NEXT_PUBLIC_API_URL=http://127.0.0.1:8000
NEXT_PUBLIC_API_URL=

# Entreprise affichée par défaut dans le tableau de bord.
# En production, remplacez par l'ID de l'entreprise connectée.
NEXT_PUBLIC_COMPANY_ID=EXPLEO-IT-001
