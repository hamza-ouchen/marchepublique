# SOU9NA — Backend (API FastAPI)
DATABASE_URL=
SUPABASE_URL=
SUPABASE_SERVICE_KEY=        # serveur uniquement - de joue le RLS, jamais cote client
ADMIN_TOKEN=
CRON_SECRET=
# "all" = toutes les entreprises éligibles ; un ID précis = ciblage manuel
SOU9NA_CRON_COMPANY=all
SOU9NA_COMPANY_STATUSES=actif,essai
SOU9NA_BATCH_SIZE=1000
SOU9NA_STALE_JOB_HOURS=2
SOU9NA_CRON_TIME=07:35
SOU9NA_CRON_TZ=Africa/Casablanca
# PDF téléchargés par entreprise après scoring (top matches uniquement)
DOCUMENT_LIMIT=40
DOCUMENT_WORKERS=8
DOCUMENT_PORTAL_SECONDS=540
DOCUMENT_FALLBACK_SECONDS=240
DOCUMENT_STORED_SECONDS=120
# Paramètres historiques des workflows Agentic, isolés des entrées actives.
SOU9NA_AGENTIC_FIRST=0
SOU9NA_AGENTIC_TIMEOUT=900
# Ancien flag COMPAGNON local (0 = scorer déterministe, 1 = flow externe direct).
SOU9NA_AGENTIC_FLOW=0
AGENTIC_API_KEY=
AGENTIC_BASE_URL=https://stg-agentic.abafusion.ai
AGENTIC_CONCIERGE_FLOW_ID=077a3600-e5c3-4b87-9e37-e56fe67004eb
AGENTIC_CONCIERGE_URL=https://stg-agentic.abafusion.ai/api/v1/run/077a3600-e5c3-4b87-9e37-e56fe67004eb
AGENTIC_MATCHING_FLOW_ID=bfa492bd-f980-4bef-b3a2-94152bc07d26
AGENTIC_MATCHING_URL=https://stg-agentic.abafusion.ai/api/v1/run/bfa492bd-f980-4bef-b3a2-94152bc07d26
AGENTIC_JUGE_FLOW_ID=ab794363-c440-4d92-9474-24c5cfbcb98d
