# SOU9NA — Backend (API FastAPI)
DATABASE_URL=
SUPABASE_URL=
SUPABASE_SERVICE_KEY=        # serveur uniquement - de joue le RLS, jamais cote client
ADMIN_TOKEN=
CRON_SECRET=
# "all" = toutes les entreprises éligibles ; un ID précis = ciblage manuel
SOU9NA_CRON_COMPANY=all
SOU9NA_COMPANY_STATUSES=actif,essai
SOU9NA_BATCH_SIZE=1000
SOU9NA_STALE_JOB_HOURS=2
SOU9NA_CRON_TIME=07:35
SOU9NA_CRON_TZ=Africa/Casablanca
# PDF téléchargés par entreprise après scoring (top matches uniquement)
DOCUMENT_LIMIT=40
DOCUMENT_WORKERS=8
DOCUMENT_PORTAL_SECONDS=540
DOCUMENT_FALLBACK_SECONDS=240
DOCUMENT_STORED_SECONDS=120
# 0 = scorer déterministe interne COMPAGNON (recommandé en production)
# 1 = tenter d'abord le flow Agentic externe, puis fallback local
SOU9NA_AGENTIC_FLOW=0
FRONTEND_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
SOU9NA_DASHBOARD_URL=
MISTRAL_API_KEY=
ANTHROPIC_API_KEY=
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=
WHATSAPP_APP_SECRET=
LANGSMITH_API_KEY=
