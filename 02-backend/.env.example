AGENTIC_JUGE_API_KEY=
# Tweaks Langflow injectés dans les runs (JSON). Les valeurs par défaut
# positionnent `limite`/`offset` en entiers pour les composants MCP Tools.
AGENTIC_CONCIERGE_TWEAKS=
AGENTIC_MATCHING_TWEAKS=
