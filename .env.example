# ═══════════════════════════════════════════════════════════════
# SOU9NA — Variables d'environnement (modèle racine)
# ═══════════════════════════════════════════════════════════════
# RÈGLE ABSOLUE : ce fichier ne contient AUCUNE vraie valeur.
# Chaque membre copie ce fichier en « .env » (jamais commité sur GitHub)
# et remplit ses propres clés localement.
# ═══════════════════════════════════════════════════════════════

# ── Base de données (Supabase / Postgres) ──
DATABASE_URL=

# ── Modèles de langage (routeur à 3 niveaux) ──
# Niveau 0 = heuristique (aucune clé) · Niveau 1 = Mistral · Niveau 2 = Claude
MISTRAL_API_KEY=
ANTHROPIC_API_KEY=

# ── WhatsApp Business Cloud API ──
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=
WHATSAPP_APP_SECRET=

# ── Sécurité des endpoints ──
CRON_SECRET=
ADMIN_TOKEN=

# ── Base vectorielle (DataStax Astra) ──
ASTRA_DB_ID=
ASTRA_DB_REGION=
ASTRA_DB_KEYSPACE=
ASTRA_DB_APPLICATION_TOKEN=

# ── Observabilité ──
LANGSMITH_API_KEY=
LANGCHAIN_PROJECT=
